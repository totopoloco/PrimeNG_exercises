{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        {
          "owner": "angular-start",
          "pattern": {
            "regexp": "(?!)",
            "file": 1,
            "message": 2
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Local:\\s+http://(localhost|127\\.0\\.0\\.1):4200/?|Network:\\s+http://[0-9.:]+:4200/?"
          }
        }
      ]
    }
  ]
}
